# Application
APP_NAME="Resume Screening System"
APP_VERSION="1.0.0"
DEBUG=False
LOG_LEVEL="INFO"

# Paths
DATA_DIR="./data"
UPLOAD_DIR="./data/uploads"
PARSED_DIR="./data/parsed"
FAISS_INDEX_PATH="./data/faiss/index.bin"
DATABASE_PATH="./data/screening.db"
MODELS_CACHE_DIR="./models_cache"

# API Security
API_KEY_ENABLED=False
API_KEY="your-secret-api-key-here"

# Processing
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=".pdf,.docx"
BACKGROUND_WORKERS=4
BATCH_SIZE=50

# ML Models
EMBEDDING_MODEL="all-MiniLM-L6-v2"
NER_MODEL="en_core_web_lg"
NER_MODEL_FALLBACK="en_core_web_sm"

# Matching
SIMILARITY_THRESHOLD=0.65
TOP_K_RESULTS=10
USE_RERANKING=False

# Bias Detection
BIAS_PROTECTED_ATTRIBUTES=["gender", "age", "ethnicity"]
BIAS_SAMPLE_SIZE=1000
BIAS_THRESHOLD=0.8

# Performance
CACHE_SIZE=100
FAISS_MEMORY_MAPPED=True
BATCH_EMBEDDING_SIZE=32

# OCR (optional - for scanned PDFs)
OCR_ENABLED=False
TESSERACT_CMD="/usr/bin/tesseract"